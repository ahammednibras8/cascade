generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum TaskRunStatus {
  PENDING
  EXECUTING
  COMPLETED
  FAILED
  CANCELED
}

enum TaskAttemptStatus {
  EXECUTING
  COMPLETED
  FAILED
  CANCELED
}

enum TaskEventLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum DeploymentStatus {
  ACTIVE
  INACTIVE
  FAILED
}

enum DeploymentRuntimeStatus {
  PENDING
  STARTING
  RUNNING
  DRAINING
  STOPPED
  FAILED
}

enum ApiKeyScope {
  TASKS_READ
  TASKS_TRIGGER
  SCHEDULES_WRITE
  RUNS_READ
  RUNS_CANCEL
  RUNS_REPLAY
  DEPLOYMENTS_WRITE
  API_KEYS_MANAGE
}

enum OrganizationRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

enum TaskScheduleType {
  INTERVAL
  CRON
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  identities  UserIdentity[]
  memberships OrganizationMember[]
  sessions    DashboardSession[]

  @@index([createdAt])
}

model UserIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  provider  String
  subject   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model DashboardSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]

  @@index([createdAt])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  slug           String   @unique
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  environments Environment[]

  @@index([organizationId])
  @@index([createdAt])
}

model Environment {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  slug      String
  name      String
  type      EnvironmentType @default(DEVELOPMENT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  apiKeys       ApiKey[]
  tasks         Task[]
  deployments   Deployment[]
  taskRuns      TaskRun[]
  taskSchedules TaskSchedule[]

  @@unique([projectId, slug])
  @@index([projectId])
}

model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  environmentId String    @db.Uuid
  name          String
  keyPrefix     String
  keyHash       String    @unique
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  scopes ApiKeyScope[] @default([TASKS_READ, TASKS_TRIGGER, SCHEDULES_WRITE, RUNS_READ, RUNS_CANCEL, RUNS_REPLAY, DEPLOYMENTS_WRITE, API_KEYS_MANAGE])

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  rotatedFromId String? @unique @db.Uuid
  rotatedFrom   ApiKey? @relation("ApiKeyRotation", fields: [rotatedFromId], references: [id])
  rotatedTo     ApiKey? @relation("ApiKeyRotation")

  @@index([environmentId, createdAt, id])
  @@index([environmentId, revokedAt, createdAt, id])
  @@index([keyPrefix])
}

model Task {
  id              String   @id @default(uuid()) @db.Uuid
  environmentId   String   @db.Uuid
  deploymentId    String?  @db.Uuid
  slug            String
  name            String
  description     String?
  executionConfig Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  deployment  Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  runs      TaskRun[]
  schedules TaskSchedule[]

  @@unique([environmentId, slug])
  @@index([environmentId])
  @@index([deploymentId])
  @@index([environmentId, deploymentId, slug, id])
}

model TaskRun {
  id                     String        @id @default(uuid()) @db.Uuid
  taskId                 String        @db.Uuid
  environmentId          String?       @db.Uuid
  deploymentId           String?       @db.Uuid
  scheduleId             String?       @db.Uuid
  scheduledFor           DateTime?
  status                 TaskRunStatus @default(PENDING)
  traceId                String?
  triggerSpanId          String?
  idempotencyKeyHash     String?
  idempotencyRequestHash String?
  payload                Json?
  output                 Json?
  error                  Json?
  executionConfig        Json?
  delayUntil             DateTime?
  startedAt              DateTime?
  lastHeartbeatAt        DateTime?
  completedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  environment Environment?  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  deployment  Deployment?   @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  schedule    TaskSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  attempts      TaskAttempt[]
  events        TaskEvent[]

  @@unique([taskId, idempotencyKeyHash])
  @@unique([scheduleId, scheduledFor])
  @@index([traceId])
  @@index([deploymentId])
  @@index([taskId, createdAt])
  @@index([scheduleId, createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, lastHeartbeatAt])
  @@index([status, delayUntil])
  @@index([environmentId, createdAt, id])
  @@index([environmentId, status, createdAt, id])
}

model TaskAttempt {
  id            String            @id @default(uuid()) @db.Uuid
  taskRunId     String            @db.Uuid
  attemptNumber Int
  status        TaskAttemptStatus @default(EXECUTING)
  error         Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  taskRun TaskRun @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  events TaskEvent[]

  @@unique([taskRunId, attemptNumber])
  @@index([taskRunId])
}

model TaskEvent {
  id            String         @id @default(uuid()) @db.Uuid
  taskRunId     String         @db.Uuid
  taskAttemptId String?        @db.Uuid
  traceId       String?
  spanId        String?
  parentSpanId  String?
  type          String
  level         TaskEventLevel @default(INFO)
  message       String?
  data          Json?
  createdAt     DateTime       @default(now())

  taskRun     TaskRun      @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  taskAttempt TaskAttempt? @relation(fields: [taskAttemptId], references: [id], onDelete: SetNull)

  outboxEntry RunEventOutbox?

  @@index([taskRunId, createdAt, id])
  @@index([taskAttemptId, createdAt])
  @@index([type, createdAt])
}

model RunEventOutbox {
  id              BigInt    @id @default(autoincrement())
  taskEventId     String    @unique @db.Uuid
  createdAt       DateTime  @default(now())
  publishedAt     DateTime?
  publishAttempts Int       @default(0)
  lockedAt        DateTime?
  lockOwner       String?

  taskEvent TaskEvent @relation(fields: [taskEventId], references: [id], onDelete: Cascade)

  @@index([publishedAt, lockedAt, id])
}

model TaskSchedule {
  id              String           @id @default(uuid()) @db.Uuid
  taskId          String           @db.Uuid
  environmentId   String?          @db.Uuid
  name            String
  payload         Json?
  scheduleType    TaskScheduleType @default(INTERVAL)
  intervalSeconds Int?
  cronExpression  String?
  timezone        String           @default("UTC")
  revision        Int              @default(1)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  enabled         Boolean          @default(true)
  lockedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  environment Environment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  runs          TaskRun[]

  @@index([taskId, nextRunAt, id])
  @@index([enabled, nextRunAt, id])
  @@index([lockedAt])
  @@index([environmentId, nextRunAt, id])
  @@index([environmentId, enabled, nextRunAt, id])
}

model Deployment {
  id            String           @id @default(uuid()) @db.Uuid
  environmentId String           @db.Uuid
  version       String
  image         String
  status        DeploymentStatus @default(ACTIVE)

  runtimeStatus      DeploymentRuntimeStatus @default(PENDING)
  runtimeContainerId String?
  runtimeError       String?
  runtimeStartedAt   DateTime?
  runtimeStoppedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  tasks         Task[]
  runs          TaskRun[]
  manifestTasks DeploymentTask[]

  @@unique([environmentId, version])
  @@index([environmentId, status])
  @@index([environmentId, createdAt, id])
}

model DeploymentTask {
  id              String   @id @default(uuid()) @db.Uuid
  deploymentId    String   @db.Uuid
  slug            String
  name            String
  description     String?
  executionConfig Json
  createdAt       DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@unique([deploymentId, slug])
}
