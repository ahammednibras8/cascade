{
  "name": "@ahammednibras8/cascade",
  "version": "0.0.0",
  "private": false,
  "description": "TypeScript SDK for defining, deploying, and triggering durable Cascade tasks.",
  "keywords": [
    "background-jobs",
    "cascade",
    "durable-execution",
    "task-runner",
    "typescript"
  ],
  "homepage": "https://github.com/ahammednibras8/cascade#readme",
  "bugs": {
    "url": "https://github.com/ahammednibras8/cascade/issues"
  },
  "author": "Ahammed Nibras",
  "repository": {
    "type": "git",
    "url": "git+http://github.com/ahammednibras8/cascade.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tshy",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@cascade/api-contracts": "workspace:*",
    "@cascade/core": "workspace:*",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tshy": "4.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "tshy": {
    "dialects": [
      "esm"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    },
    "project": "./tsconfig.build.json"
  },
  "engines": {
    "node": ">=20"
  }
}
