{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "packages/database/src/generated/prisma/browser.ts",
    "packages/database/src/generated/prisma/internal/prismaNamespaceBrowser.ts"
  ],
  "ignoreIssues": {
    "packages/database/src/generated/**": ["exports", "types"]
  },
  "ignoreBinaries": ["goose", "helm", "infisical", "mint"],
  "workspaces": {
    ".": {
      "entry": ["package.json", "examples/hello-deployment/tasks/index.mjs"]
    },
    "apps/api": {
      "entry": ["src/index.ts", "src/dev/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/dashboard": {
      "entry": ["app/routes/**/*.{ts,tsx}"],
      "project": ["app/**/*.{ts,tsx}", "app/**/*.css", "test/**/*.{ts,tsx}", "*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/api-contracts": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/database": {
      "entry": ["prisma/seed/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts", "prisma/**/*.prisma"]
    },
    "packages/sdk": {
      "project": ["src/**/*.ts"]
    },
    "packages/storage": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/worker": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/clickhouse": {
      "entry": ["package.json"],
      "project": []
    },
    "docs": {
      "entry": ["package.json"],
      "project": []
    },
    "apps/e2e": {
      "entry": ["tests/**/*.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@cascade/dashboard"]
    }
  },
  "treatConfigHintsAsErrors": true
}
