{
  "name": "cascade",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "api:create-key": "infisical run --env=dev --path=/ --path=/apps/api -- pnpm --filter @cascade/api run dev:create-api-key",
    "dashboard:sync-api-key": "pnpm --filter @cascade/api run dev:sync-dashboard-api-key",
    "api:dev": "pnpm --filter @cascade/api run dev",
    "dashboard:dev": "pnpm --filter @cascade/dashboard run dev",
    "worker:dev": "pnpm --filter @cascade/worker run dev",
    "sdk:build": "pnpm --filter @cascade/sdk run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ci": "oxlint --deny-warnings",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@cascade/api --filter=@cascade/dashboard --filter=@cascade/core --filter=@cascade/database --filter=@cascade/deployment-runner --filter=@cascade/sdk --filter=@cascade/storage --filter=@cascade/worker",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "e2e": "turbo run e2e",
    "e2e:ui": "turbo run e2e:ui",
    "e2e:headed": "turbo run e2e:headed",
    "e2e:report": "turbo run e2e:report",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "knip:deps": "knip --dependencies",
    "knip:prod": "knip --exclude devDependencies --no-config-hints",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "hooks:validate": "lefthook validate",
    "hooks:pre-commit": "lefthook run pre-commit",
    "hooks:pre-push": "lefthook run pre-push",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "docs:dev": "pnpm --filter @cascade/docs run dev",
    "docs:check": "pnpm --filter @cascade/docs run check",
    "services:up": "docker compose --env-file docker/.env -f docker/compose.yml up -d",
    "services:down": "docker compose --env-file docker/.env -f docker/compose.yml down",
    "services:logs": "docker compose --env-file docker/.env -f docker/compose.yml logs -f",
    "services:ps": "docker compose --env-file docker/.env -f docker/compose.yml ps",
    "services:reset": "docker compose --env-file docker/.env -f docker/compose.yml down -v",
    "compose:build": "COMPOSE_PARALLEL_LIMIT=1 docker compose --env-file docker/.env -f docker/compose.yml --profile app build api dashboard worker deployment-runner",
    "compose:up": "docker compose --env-file docker/.env -f docker/compose.yml --profile app up -d --no-build",
    "compose:rebuild": "pnpm run compose:build && pnpm run compose:up",
    "compose:up:storage": "docker compose --env-file docker/.env -f docker/compose.yml --profile app --profile storage up -d --no-build",
    "compose:down": "docker compose --env-file docker/.env -f docker/compose.yml --profile app --profile storage down",
    "compose:logs": "docker compose --env-file docker/.env -f docker/compose.yml --profile app --profile storage logs -f",
    "compose:ps": "docker compose --env-file docker/.env -f docker/compose.yml --profile app --profile storage ps",
    "hosting:lint": "helm lint hosting/k8s/helm -f hosting/k8s/helm/values.lint.yaml",
    "hosting:template": "helm template cascade hosting/k8s/helm -f hosting/k8s/helm/values.lint.yaml",
    "hosting:template:local": "helm template cascade hosting/k8s/helm -f hosting/k8s/helm/values.local.yaml",
    "hosting:install:local": "helm upgrade --install cascade hosting/k8s/helm --namespace cascade --create-namespace -f hosting/k8s/helm/values.local.yaml",
    "hosting:uninstall:local": "helm uninstall cascade --namespace cascade",
    "secrets:scan": "infisical scan",
    "secrets:dev": "infisical run --env=dev --path=/ -- pnpm run dev",
    "secrets:dashboard:dev": "infisical run --env=dev --path=/ --path=/apps/dashboard -- pnpm --filter @cascade/dashboard run dev",
    "secrets:api:dev": "infisical run --env=dev --path=/ --path=/apps/api -- pnpm --filter @cascade/api run dev",
    "secrets:worker:dev": "infisical run --env=dev --path=/ -- pnpm --filter @cascade/worker run dev",
    "db:generate": "pnpm --filter @cascade/database run db:generate",
    "db:generate:check": "node scripts/check-generated-prisma.mjs",
    "db:validate": "pnpm --filter @cascade/database run db:validate",
    "db:migrate": "pnpm --filter @cascade/database run db:migrate",
    "db:deploy": "pnpm --filter @cascade/database run db:deploy",
    "db:studio": "pnpm --filter @cascade/database run db:studio",
    "db:reset": "pnpm --filter @cascade/database run db:reset",
    "db:seed": "pnpm --filter @cascade/database run db:seed",
    "clickhouse:migrate": "infisical run --env=dev --path=/ -- pnpm --filter @cascade/clickhouse run migrate",
    "clickhouse:rollback": "infisical run --env=dev --path=/ -- pnpm --filter @cascade/clickhouse run rollback",
    "clickhouse:status": "infisical run --env=dev --path=/ -- pnpm --filter @cascade/clickhouse run status",
    "repo:quick": "pnpm run fmt:check && pnpm run lint:ci && pnpm run check-types",
    "repo:deps": "pnpm run knip:prod",
    "repo:security": "pnpm run secrets:scan",
    "repo:verify": "pnpm run hooks:validate && pnpm run repo:quick && pnpm run repo:deps && pnpm run repo:security"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "knip": "6.32.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "pnpm@11.13.1"
}
