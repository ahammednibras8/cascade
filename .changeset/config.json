{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "@cascade/api",
    "@cascade/clickhouse",
    "@cascade/dashboard",
    "@cascade/database",
    "@cascade/deployment-runner",
    "@cascade/docs",
    "@cascade/e2e",
    "@cascade/storage",
    "@cascade/telemetry",
    "@cascade/worker"
  ],
  "bumpVersionsWithWorkspaceProtocolOnly": false,
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "format": "oxfmt"
}
