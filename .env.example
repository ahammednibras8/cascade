DATABASE_URL=postgresql://cascade:cascade@localhost:15432/cascade

REDIS_URL=redis://localhost:16379
QUEUE_REDIS_URL=redis://localhost:16379

CLICKHOUSE_URL=http://cascade:cascade@localhost:18123/cascade
CLICKHOUSE_NATIVE_URL=tcp://cascade:cascade@localhost:19000/cascade

API_PORT=3001
API_JSON_BODY_LIMIT_BYTES=5242880
API_RATE_LIMIT_MAX_REQUESTS=300
API_RATE_LIMIT_WINDOW_MS=60000
# Generate with: openssl rand -base64 32
API_KEY_PEPPER=replace-with-random-secret

WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=3002
QUEUE_CONCURRENCY_RETRY_MS=1000

S3_ENDPOINT=http://localhost:19090
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cascade
S3_SECRET_ACCESS_KEY=cascade-password
S3_BUCKET=cascade-task-payloads
S3_FORCE_PATH_STYLE=true
LARGE_PAYLOAD_THRESHOLD_BYTES=262144

CASCADE_API_URL=http://localhost:3001
CASCADE_DASHBOARD_API_KEY=change-me

# Re-enqueue a PENDING run if it has not been claimed by a worker.
PENDING_RUN_RECOVERY_MS=30000

# How often the worker scans Postgres for recoverable PENDING runs.
PENDING_RUN_SWEEP_INTERVAL_MS=10000

# How frequently a worker checks whether an executing run was canceled.
TASK_RUN_CANCELLATION_POLL_INTERVAL_MS=500

# Local worker mode. Leave CASCADE_TASK_MODULE unset in development to use built-in local tasks.
CASCADE_WORKER_ROLE=local
CASCADE_DEPLOYMENT_ID=local
CASCADE_TASK_MODULE=
# CASCADE_TASK_MODULE=file:///absolute/path/to/tasks.js

# E2E/dashboard dev server defaults.
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_REUSE_SERVERS=true

# Deployment runner defaults.
DEPLOYMENT_RUNTIME=docker
DEPLOYMENT_DATABASE_URL=postgresql://cascade:cascade@localhost:15432/cascade
DEPLOYMENT_QUEUE_REDIS_URL=redis://localhost:16379
DEPLOYMENT_DOCKER_NETWORK=cascade_default
DEPLOYMENT_WORKER_CONCURRENCY=2
DEPLOYMENT_RUNNER_POLL_MS=5000
DEPLOYMENT_PULL_IMAGES=false
# Required only when DEPLOYMENT_RUNTIME=kubernetes.
DEPLOYMENT_KUBERNETES_NAMESPACE=default
# DEPLOYMENT_KUBERNETES_RUNTIME_SECRET_NAME=cascade-runtime

# OpenTelemetry is disabled by default. If OTEL_ENABLED=true and mode is otlp,
# OTEL_EXPORTER_OTLP_ENDPOINT must point to an OTLP HTTP collector.
OTEL_ENABLED=false
OTEL_EXPORTER_MODE=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cascade-api
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_METRIC_EXPORT_INTERVAL_MS=1000
CASCADE_VERSION=development

# Comma-separated browser origins. Do not use * for an API that accepts API keys.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum time spent checking PostgreSQL or Redis in /readyz.
HEALTHCHECK_DEPENDENCY_TIMEOUT_MS=2000