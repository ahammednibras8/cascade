{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".turbo/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "blob-report/**",
    "pnpm-lock.yaml",
    ".tshy-build/"
  ],
  "rules": {
    "no-console": "warn",
    "import/no-unassigned-import": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_count", "_avg", "_sum", "_min", "_max"]
      }
    ],
    "complexity": [
      "warn",
      {
        "max": 12
      }
    ],
    "max-depth": ["warn", 4],
    "max-lines": [
      "warn",
      {
        "max": 320,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 90,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["warn", 4],
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "apps/e2e/tests/**/*.ts"
      ],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 360,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "warn",
          {
            "max": 140,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-params": "off"
      }
    },
    {
      "files": ["apps/dashboard/app/**/*.tsx"],
      "rules": {
        "max-lines": [
          "warn",
          {
            "max": 340,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "warn",
          {
            "max": 130,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
