# Copy this file to an untracked docker/.env, then fill every empty value from
# your secret manager. Never commit docker/.env or reuse values between environments.

POSTGRES_DB=cascade
POSTGRES_USER=cascade
POSTGRES_PASSWORD=cascade

# Required. Generate a URL-safe random value.
REDIS_PASSWORD=cascade-redis-password

# Required. Keep the password URL-safe, or percent-encode it in these URLs.
QUEUE_REDIS_URL=redis://default:cascade-redis-password@redis:6379
DEPLOYMENT_QUEUE_REDIS_URL=redis://default:cascade-redis-password@redis:6379

API_PORT=3001
API_JSON_BODY_LIMIT_BYTES=5242880
API_RATE_LIMIT_MAX_REQUESTS=300
API_RATE_LIMIT_WINDOW_MS=60000
DASHBOARD_PORT=3000
API_KEY_PEPPER=local-api-key-pepper-for-docker-dev-only-0000000000000000

WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=3002
DEPLOYMENT_RUNTIME=docker
DEPLOYMENT_DOCKER_NETWORK=cascade_default
DEPLOYMENT_WORKER_CONCURRENCY=2
DEPLOYMENT_RUNNER_POLL_MS=5000
DEPLOYMENT_PULL_IMAGES=false

S3_BUCKET=cascade-task-payloads
LARGE_PAYLOAD_THRESHOLD_BYTES=262144

RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=cascade
RUSTFS_SECRET_KEY=cascade-rustfs-secret

CLICKHOUSE_DB=cascade
CLICKHOUSE_USER=cascade
CLICKHOUSE_PASSWORD=cascade

DASHBOARD_SESSION_SECRET=local-dashboard-session-secret-for-docker-dev-only-000000
DASHBOARD_API_AUTH_SECRET=local-dashboard-api-auth-secret-for-docker-dev-only-000000
OIDC_ISSUER_URL=http://localhost:3000
OIDC_CLIENT_ID=cascade-dashboard-local
OIDC_CLIENT_SECRET=local-oidc-client-secret-for-docker-dev-only
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

OTEL_ENABLED=false
OTEL_EXPORTER_MODE=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_METRIC_EXPORT_INTERVAL_MS=1000
CASCADE_VERSION=development

# Comma-separated browser origins. Do not use * for an API that accepts API keys.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum time spent checking PostgreSQL or Redis in /readyz.
HEALTHCHECK_DEPENDENCY_TIMEOUT_MS=2000
